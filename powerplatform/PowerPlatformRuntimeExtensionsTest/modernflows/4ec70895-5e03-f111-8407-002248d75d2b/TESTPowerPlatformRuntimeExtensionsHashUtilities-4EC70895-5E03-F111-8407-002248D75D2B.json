{
  "properties": {
    "connectionReferences": {
      "dataverse": {
        "impersonation": {
          "source": "invoker"
        },
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "test_pwrplatf_PowerPlatformRuntimeExtensions_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "Random_Data": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "actionName": "pwrplatf_GenerateRandomData",
              "item/ByteCount": 100
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "PerformUnboundAction",
              "connectionName": "dataverse"
            },
            "retryPolicy": {
              "type": "none"
            }
          }
        },
        "Foreach_Cryptographic_Hash_algorithm": {
          "foreach": [
            "SHA1",
            "SHA256",
            "SHA384",
            "MD5"
          ],
          "actions": {
            "Cryptographic_Hash": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "actionName": "pwrplatf_ComputeHash",
                  "item/PayloadBase64": "@body('Random_Data')['DataBase64']",
                  "item/HashAlgorithmName": "@item()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "connectionName": "dataverse"
                },
                "retryPolicy": {
                  "type": "none"
                }
              }
            }
          },
          "runAfter": {
            "Random_Data": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        },
        "Foreach_Non-Cryptographic_Hash_algorithm": {
          "foreach": [
            "Crc32",
            "Crc64",
            "XxHash3",
            "XxHash32",
            "XxHash64",
            "XxHash128"
          ],
          "actions": {
            "Non-Cryptographic_Hash": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "actionName": "pwrplatf_ComputeNonCryptoHash",
                  "item/PayloadBase64": "@body('Random_Data')['DataBase64']",
                  "item/HashAlgorithmName": "@item()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "connectionName": "dataverse"
                },
                "retryPolicy": {
                  "type": "none"
                }
              }
            }
          },
          "runAfter": {
            "Random_Data": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        },
        "Text_Sample": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "https://make.powerautomate.com/environments/@{workflow().tags.environmentName}/flows/@{workflow().name}/runs/@{workflow().run.name}"
        },
        "Foreach_textual_Non-Cryptographic_Hash_algorithm": {
          "foreach": [
            "Crc32",
            "Crc64",
            "XxHash3",
            "XxHash32",
            "XxHash64",
            "XxHash128"
          ],
          "actions": {
            "Non-Cryptographic_Hash_over_text": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "actionName": "pwrplatf_ComputeNonCryptoHash",
                  "item/HashAlgorithmName": "@item()",
                  "item/PayloadText": "@outputs('Text_Sample')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "connectionName": "dataverse"
                },
                "retryPolicy": {
                  "type": "none"
                }
              }
            }
          },
          "runAfter": {
            "Text_Sample": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}